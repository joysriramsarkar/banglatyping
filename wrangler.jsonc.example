{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "banglatyping",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // NOTE: Never commit secrets here. Set SUPABASE_SERVICE_KEY and any other
  // secret via `wrangler secret put <NAME>` or the Cloudflare dashboard.
  // Only public NEXT_PUBLIC_* placeholders belong in vars.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://your-project-ref.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "your-anon-key-placeholder",
    "NEXT_PUBLIC_SITE_URL": "https://typing.onuron.org"
  }
}
