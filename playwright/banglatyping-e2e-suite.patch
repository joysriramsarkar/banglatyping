+      "ক", " ", "ল", " ", "স", " ", "া", " ", "ক", "ল", " ", "স", "া",
+      " ", "ড", "ফ", " ", "গ", "হ", " ", "জ", "ক", " ", "ল", "স", " ",
+      "ক", " ", "স", " ", "ল", " ", "া", " ", "ড", " ", "ফ", " ",
