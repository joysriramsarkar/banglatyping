+      ["ইউনিজয় (Unijoy)", "unijoy"],
+    ] as const;
+
+    for (const [label, value] of layouts) {
+      await page.getByText(label, { exact: true }).click();
+      await expect.poll(() => readLocalStorage(page, LAYOUT_STORAGE_KEY)).toBe(value);
