+  test("can cycle through all supported layout values", async ({ page }) => {
+    const layouts = [
+      ["লিপিঘর বাংলাওয়ার্ড (BanglaWord)", "banglaword"],
+      ["ক্ষিপ্র (Khipro)", "khipro"],
