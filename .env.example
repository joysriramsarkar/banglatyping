# Supabase project settings — Project Settings > API
# Copy to .env.local and fill in your own values.

# Public, safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-side only — never expose it to the browser.
# Used by the seed and diagnostic scripts in scripts/ and db/seeds/.
SUPABASE_SERVICE_KEY=your-service-role-key
