# Copy to .env.local and fill in your own values. Never commit real keys.
# See .env.production.example for production placeholders.

# Public, safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder-min-20-chars
NEXT_PUBLIC_SITE_URL=https://typing.onuron.org

# Server-side only — NEVER expose to the browser (no NEXT_PUBLIC_ prefix).
# Used by seed and diagnostic scripts in scripts/ and db/seeds/.
SUPABASE_SERVICE_KEY=your-service-role-key-placeholder

# --- Optional integrations (uncomment to use) ---
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_CRISP_WEBSITE_ID=
# OPENAI_API_KEY=
