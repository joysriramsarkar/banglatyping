{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "banglatyping",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // NOTE: Never put secrets (e.g. SUPABASE_SERVICE_KEY) in vars.
  // Public, non-secret build-time values only. Secrets must be set via
  // `wrangler secret put <NAME>` or the Cloudflare dashboard.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://example.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "example-anon-key-placeholder",
    "NEXT_PUBLIC_SITE_URL": "https://typing.onuron.org"
  }
}
